{
  "name": "jellyfin-danmaku",
  "version": "2.0.0",
  "description": "Jellyfin 弹幕插件 - TypeScript + Svelte 5 重构版",
  "type": "module",
  "scripts": {
    "dev": "vite --config build/vite.userscript.config.ts",
    "build": "vite build --config build/vite.standalone.config.ts",
    "build:userscript": "vite build --config build/vite.userscript.config.ts",
    "build:all": "npm run build && npm run build:userscript",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,svelte}'",
    "lint": "eslint 'src/**/*.{ts,svelte}'"
  },
  "keywords": [
    "jellyfin",
    "danmaku",
    "userscript",
    "tampermonkey"
  ],
  "author": "RyoLee, Izumiko",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "danmaku": "^2.0.10"
  }
}
