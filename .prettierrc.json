{
  "singleQuote": true,
  "requirePragma": false,
  "insertPragma": false,
  "useTabs": false,
  "tabWidth": 4,
  "semi": true,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "printWidth": 180,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }]
}